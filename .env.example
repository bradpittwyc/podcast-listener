# Required for Groq subtitles; official transcripts and complete cached subtitles work without it.
GROQ_API_KEY=
# Optional second key: alternate chunks and transcribe up to two in parallel.
GROQ_API_KEY_2=
# GROQ_API_KEY_1 can also be used instead of GROQ_API_KEY for the first key.
# Optional context-aware dictionary (otherwise use the free dictionary).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional HTTP proxy, e.g. http://127.0.0.1:7890. HTTP(S)_PROXY is also supported.
PODCAST_PROXY=
HOST=127.0.0.1
PORT=8557
