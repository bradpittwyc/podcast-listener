# Alibaba keys remain available for dictionary, translation and tutor.
DASHSCOPE_API_KEY_1=
DASHSCOPE_API_KEY_2=
ALIYUN_REGION=beijing
DICTIONARY_PROVIDER=auto
# Web subtitle transcription, plus optional Gemini dictionary/translation/tutor.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional Web transcription pool; distinct keys rotate by 20-minute segment.
GEMINI_TRANSCRIPTION_KEY_1=
GEMINI_TRANSCRIPTION_KEY_2=
GEMINI_TRANSCRIPTION_KEY_3=
GEMINI_TRANSCRIPTION_KEY_4=
GEMINI_TRANSCRIPTION_KEY_5=
GEMINI_MODEL=gemini-3.5-flash
# Optional audio HTTP proxy. Standard proxy variables also apply to cloud connections.
PODCAST_PROXY=
HOST=127.0.0.1
PORT=8557

# Subtitle translation: gemini or qwen
TRANSLATION_PROVIDER=gemini

# Tutor model: qwen (default) or gemini
TUTOR_PROVIDER=qwen
